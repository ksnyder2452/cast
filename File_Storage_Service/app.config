<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <add key="rabbitmq_home" value="localhost" />
        <add key="rabbitmq_port" value="5672" />
        <add key="rabbitmq_user" value="file_store_admin" />
        <add key="rabbitmq_pwd" value="file_store_pwd" />
        <add key="service_name" value="File Storage Service" />
    </appSettings>
</configuration>
