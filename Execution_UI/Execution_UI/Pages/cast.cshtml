@page
@model CastModel
@{
    ViewData["Title"] = "Execution Controller";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - CAST</title>
    <link rel="stylesheet" href="/css/font-awesome-4.7.0/css/font-awesome.css">
    <link rel="stylesheet" href="https://snippet.dhtmlx.com/codebase/assets/css/auxiliary_controls.css">
    <link rel="stylesheet" href="/suite_gpl/codebase/suite.css?v=9.2.3">
    <link rel="stylesheet" href="/css/index.css">
    <style>
        /* Override body background to be fixed and extend fully */
        html {
            background: radial-gradient(1200px 600px at 15% 0%, rgba(56, 189, 248, 0.18), transparent 60%),
                radial-gradient(900px 600px at 85% 15%, rgba(34, 197, 94, 0.16), transparent 60%), linear-gradient(180deg, #808080, #45484e);
            background-attachment: fixed;
        }

        body {
            background: transparent;
            min-height: 100vh;
        }

        .wrap {
            min-height: auto;
            display: flex;
            flex-direction: column;
        }

        /* Cast Page Specific Overrides */
        .controls-section {
            border: 1px solid var(--border);
            border-radius: var(--radius2);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
            padding: 16px;
            margin-bottom: 16px;
        }

        .controls-section h3 {
            margin: 0 0 12px 0;
            font-size: 1.05rem;
            letter-spacing: 0.2px;
            color: var(--text);
        }

        .filter-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 12px;
        }

        .filter-group label {
            color: var(--muted);
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
        }

        select {
            width: 100%;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
            font-size: 0.95rem;
            cursor: pointer;
            transition: border-color 0.12s ease, background 0.12s ease;
        }

        select:hover {
            border-color: rgba(255, 255, 255, 0.22);
            background: rgba(255, 255, 255, 0.06);
        }

        select:focus {
            outline: none;
            border-color: var(--accent);
            background: rgba(255, 255, 255, 0.08);
        }

        select option {
            background: #2a2a2a;
            color: #ffffff;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .checkbox-group input[type="checkbox"] {
            cursor: pointer;
            width: 18px;
            height: 18px;
            accent-color: var(--accent);
        }

        .checkbox-group label {
            margin: 0;
            color: var(--muted);
            font-weight: 600;
            cursor: pointer;
        }

        .scrollable-table-container {
            border: 1px solid var(--border);
            border-radius: var(--radius2);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
            overflow-x: auto;
            overflow-y: auto;
            margin-top: 14px;
            margin-bottom: 16px;
            max-height: none;
            height: auto;
            display: block;
        }

        .scrollable-table-container:has(#frameworkStateTable) {
            max-height: 300px;
        }

        .scrollable-table-container table {
            margin: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            color: var(--text);
            table-layout: auto;
        }

        table.table {
            margin-bottom: 0;
        }

        table thead {
            background: rgba(69, 72, 78, 0.95);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1000;
            background-clip: padding-box;
        }

        table th {
            padding: 12px 14px;
            text-align: left;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--muted);
            letter-spacing: 0.2px;
            position: relative;
            z-index: 1000;
            background: rgba(69, 72, 78, 0.95);
        }

        table tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            transition: background 0.12s ease;
            position: relative;
            z-index: 1;
        }

        table tbody tr:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        table td {
            padding: 12px 14px;
            font-size: 0.95rem;
        }

        table .btn {
            padding: 8px 10px;
            font-size: 0.85rem;
            min-width: auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Display custom action icons horizontally */
        #frameworkStateTable td:has(> button[name="customAction"]) {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            align-items: center;
        }

        .table-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text);
            margin: 16px 0 12px 0;
            letter-spacing: 0.2px;
        }

        /* Override Bootstrap table styles */
        #frameworkStateTable,
        #serviceStateTable {
            margin: 0;
            border: 0;
            background: transparent;
            width: 100%;
            display: table;
        }

        #frameworkStateTable thead th,
        #serviceStateTable thead th {
            background: rgba(69, 72, 78, 0.95);
            border-bottom: 1px solid var(--border);
            padding: 12px 14px;
            text-align: left;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--muted);
            letter-spacing: 0.2px;
            position: relative;
            z-index: 1000;
        }

        #frameworkStateTable tbody tr,
        #serviceStateTable tbody tr {
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            position: relative;
            z-index: 1;
        }

        #frameworkStateTable tbody tr:hover,
        #serviceStateTable tbody tr:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        #frameworkStateTable td,
        #serviceStateTable td {
            padding: 6px 14px;
            font-size: 0.95rem;
            color: var(--text);
            border: 0;
        }

        #frameworkStateTable td {
            font-size: 0.85rem;
        }

        #frameworkStateTable th {
            font-size: 0.9rem;
        }

        /* Reduce serviceStateTable visual space */
        #serviceStateTable {
            margin: 0;
        }

        #serviceStateTable tbody tr {
            line-height: 1;
        }

        #serviceStateTable td {
            padding: 2px 14px;
            font-size: 0.85rem;
            line-height: 1.2;
        }

        #serviceStateTable thead th {
            padding: 4px 14px;
            font-size: 0.85rem;
            line-height: 1;
        }

        /* Ensure form and body styling extends throughout page */
        form#cast_table {
            width: 100%;
        }

        form#cast_table section,
        form#cast_table>div,
        form#cast_table>h2 {
            color: var(--text);
        }

        /* Ensure proper styling for all form elements */
        form#cast_table input[type="checkbox"],
        form#cast_table input[type="text"],
        form#cast_table textarea {
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
            border: 1px solid var(--border);
        }
    </style>
</head>

<body>
    @if (Model.IsLoginRequired && !Model.IsAuthenticated)
    {
        <div class="login-container"
            style="display: flex; justify-content: center; align-items: center; min-height: 100vh;">
            <div
                style="background: rgba(255, 255, 255, 0.08); padding: 40px; border-radius: 12px; border: 1px solid var(--border); width: 100%; max-width: 400px;">
                <h2 style="text-align: center; margin-bottom: 30px; color: var(--text);">CAST Login</h2>

                @if (!string.IsNullOrEmpty(Model.AuthenticationError))
                {
                    <div
                        style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; color: #fca5a5; padding: 12px; border-radius: 8px; margin-bottom: 20px; text-align: center;">
                        @Model.AuthenticationError
                    </div>
                }

                <form method="post" asp-page-handler="Login">
                    <div style="margin-bottom: 20px;">
                        <label for="username"
                            style="display: block; color: var(--muted); margin-bottom: 8px; font-weight: 600;">Username</label>
                        <input type="text" id="username" name="username" placeholder="Enter username" required
                            style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: rgba(255, 255, 255, 0.04); color: var(--text); font-size: 1rem; box-sizing: border-box;" />
                    </div>

                    <div style="margin-bottom: 30px;">
                        <label for="password"
                            style="display: block; color: var(--muted); margin-bottom: 8px; font-weight: 600;">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter password" required
                            style="width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; background: rgba(255, 255, 255, 0.04); color: var(--text); font-size: 1rem; box-sizing: border-box;" />
                    </div>

                    <button type="submit"
                        style="width: 100%; padding: 12px; background: linear-gradient(135deg, var(--accent) 0%, #06b6d4 100%); color: white; border: none; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;"
                        onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(6, 182, 212, 0.4)'"
                        onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none'">
                        Login
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="wrap">
            <header class="topbar">
                <a class="brand" href="/">
                    <span class="logo" aria-hidden="true"></span>
                    <div>
                        <h1>CAST</h1>
                        <p>Centralized Automation of Software Tools</p>
                    </div>
                </a>

                <div class="checkbox-group" style="margin-bottom: 0;">
                    <input type="checkbox" id="autorefresh" name="autorefresh" onclick="ManageAutorefresh(this);" checked />
                    <label for="autorefresh">Enable auto-refresh</label>
                </div>
            </header>

            <form method="post" id="cast_table">
                <h2 class="table-title">Service Health Check</h2>
                <div class="scrollable-table-container">
                    <table id="serviceStateTable">
                        <tbody>
                            <tr>
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.serviceName.Count;
                                                            countMYSQLRecords++)
                                {
                                    <td>@Model.serviceName[countMYSQLRecords]</td>
                                }
                            </tr>
                            <tr>
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.serviceName.Count;
                                                            countMYSQLRecords++)
                                {
                                    @if (@Model.serviceState[countMYSQLRecords].ToUpper().Equals("ONLINE"))
                                    {
                                        <td style="color: #22c55e;">@Model.serviceState[countMYSQLRecords]</td>
                                    }
                                    else if (@Model.serviceState[countMYSQLRecords].ToUpper().Equals("OFFLINE"))
                                    {
                                        <td style="color: #ee2727;">@Model.serviceState[countMYSQLRecords]</td>
                                    }
                                    else if (@Model.serviceState[countMYSQLRecords].ToUpper().Equals("UNDER CONSTRUCTION"))
                                    {
                                        <td style="color: #e79f23;">@Model.serviceState[countMYSQLRecords]</td>
                                    }
                                    else
                                    {
                                        <td style="color: #ee2727;">@Model.serviceState[countMYSQLRecords]</td>
                                    }
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h2 class="table-title">Client Frameworks</h2>
                <section class="controls-section">
                    <h3>Filters</h3>
                    <div class="filter-group">
                        <div>
                            <label for="selectedGroupOption">Group:</label>
                            <select id="selectedGroupOption" name="selectedGroupOption" onchange="changeSelectedGroup();">
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.filterFrameworksOnGroup.Count;
                                                            countMYSQLRecords++)
                                {
                                    @if (CastModel.currentGroup.Equals(@Model.filterFrameworksOnGroup[countMYSQLRecords]))
                                    {
                                        <option selected value=@Model.filterFrameworksOnGroup[countMYSQLRecords]>
                                            @Model.filterFrameworksOnGroup[countMYSQLRecords]</option>
                                    }
                                    else
                                    {
                                        <option value=@Model.filterFrameworksOnGroup[countMYSQLRecords]>
                                            @Model.filterFrameworksOnGroup[countMYSQLRecords]</option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label for="selectedOwnerOption">Owner:</label>
                            <select id="selectedOwnerOption" name="selectedOwnerOption" onchange="changeSelectedOwner();">
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.filterFrameworksOnOwner.Count;
                                                            countMYSQLRecords++)
                                {
                                    @if (CastModel.currentOwner.Equals(@Model.filterFrameworksOnOwner[countMYSQLRecords]))
                                    {
                                        <option selected value=@Model.filterFrameworksOnOwner[countMYSQLRecords]>
                                            @Model.filterFrameworksOnOwner[countMYSQLRecords]</option>
                                    }
                                    else
                                    {
                                        <option value=@Model.filterFrameworksOnOwner[countMYSQLRecords]>
                                            @Model.filterFrameworksOnOwner[countMYSQLRecords]</option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label for="selectedLocationOption">Location:</label>
                            <select id="selectedLocationOption" name="selectedLocationOption"
                                onchange="changeSelectedLocation();">
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.filterFrameworksOnLocation.Count;
                                                            countMYSQLRecords++)
                                {
                                    @if
                                                                (CastModel.currentLocation.Equals(@Model.filterFrameworksOnLocation[countMYSQLRecords]))
                                    {
                                        <option selected value=@Model.filterFrameworksOnLocation[countMYSQLRecords]>
                                            @Model.filterFrameworksOnLocation[countMYSQLRecords]</option>
                                    }
                                    else
                                    {
                                        <option value=@Model.filterFrameworksOnLocation[countMYSQLRecords]>
                                            @Model.filterFrameworksOnLocation[countMYSQLRecords]</option>
                                    }
                                }
                            </select>
                        </div>

                        <div>
                            <label for="selectedKeywordOption">Keyword:</label>
                            <select id="selectedKeywordOption" name="selectedKeywordOption"
                                onchange="changeSelectedKeyword();">
                                @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.filterFrameworksOnKeyword.Count;
                                                            countMYSQLRecords++)
                                {
                                    @if
                                                                (CastModel.currentKeyword.Equals(@Model.filterFrameworksOnKeyword[countMYSQLRecords]))
                                    {
                                        <option selected value=@Model.filterFrameworksOnKeyword[countMYSQLRecords]>
                                            @Model.filterFrameworksOnKeyword[countMYSQLRecords]</option>
                                    }
                                    else
                                    {
                                        <option value=@Model.filterFrameworksOnKeyword[countMYSQLRecords]>
                                            @Model.filterFrameworksOnKeyword[countMYSQLRecords]</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </section>


                <div class="scrollable-table-container">
                    <table id="frameworkStateTable">
                        <thead>
                            <tr>
                                <th>Cleanup</th>
                                <th>Client Name</th>
                                <th>State</th>
                                <th>Start</th>
                                <th>Stop</th>
                                <th>Pause</th>
                                <th>Resume</th>
                                <th>Abort</th>
                                <th>Restart</th>
                                <th>Custom</th>
                                <th>Schedule</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int countMYSQLRecords = 0; countMYSQLRecords < Model.displayNames.Count;
                                                    countMYSQLRecords++)
                            {
                                @if (!Model.currentState[countMYSQLRecords].ToUpper().StartsWith("OFFLINE"))
                                {
                                    <tr>
                                        <td>
                                            <button class="btn" type="submit" name="RemoveEntry"
                                                asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                asp-page-handler="MyAction10"><i class="fa fa-trash-o" title="Cleanup"
                                                    style="font-size:24px"></i></button>
                                        </td>
                                        <td>@Model.displayNames[countMYSQLRecords]</td>
                                        <td style="color: @Model.currentStateColor[countMYSQLRecords];">
                                            @Model.currentState[countMYSQLRecords]</td>
                                        @if (Model.startRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button hidden class="btn" type="submit" name="StartRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction2"><i class="fa fa-play" title="Start"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="StartRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction2"><i class="fa fa-play" title="Start"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        @if (Model.stopRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button hidden class="btn" type="submit" name="StopRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction3"><i class="fa fa-stop" title="Stop"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="StopRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction3"><i class="fa fa-stop" title="Stop"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        @if (Model.pauseRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button class="btn" hidden type="submit" name="PauseRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction4"><i class="fa fa-pause" title="Pause"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="PauseRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction4"><i class="fa fa-pause" title="Pause"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        @if (Model.resumeRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button class="btn" hidden type="submit" name="ResumeRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction5"><i class="fa fa-forward-step" title="Resume"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="ResumeRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction5"><i class="fa fa-forward-step" title="Resume"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        @if (Model.abortRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button class="btn" hidden type="submit" name="abortRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction6"><i class="fa fa-ban" title="Abort"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="abortRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction6"><i class="fa fa-ban" title="Abort"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        @if (Model.restartRun[countMYSQLRecords] == "no")
                                        {
                                            <td>
                                                <button class="btn" hidden type="submit" name="restartRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction7"><i class="fa fa-circle-play" title="Restart"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <button class="btn" type="submit" name="restartRun"
                                                    asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                    asp-page-handler="MyAction7"><i class="fa fa-circle-play" title="Restart"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        <td>
                                            @for (int countCustomActions = 0; countCustomActions < @Model.customActionName.Count;
                                                                            countCustomActions++)
                                            {
                                                @if
                                                                                (@Model.customActionName[countCustomActions].StartsWith(@Model.originatorUUIDs[countMYSQLRecords])
                                                                                && (@Model.currentState[countMYSQLRecords].ToUpper().StartsWith("READY")) &&
                                                                                !@Model.customActionHideBeforeStart[countCustomActions])
                                                {
                                                    <button class="btn" type="submit" name="customAction"
                                                        asp-route-id="@Model.customActionName[countCustomActions]"
                                                        asp-page-handler="MyAction9"><i class="@Model.customActionIcon[countCustomActions]"
                                                            title="@Model.customActionDescription[countCustomActions]"
                                                            style="font-size:24px"></i></button>
                                                }
                                                else if
                                                (@Model.customActionName[countCustomActions].StartsWith(@Model.originatorUUIDs[countMYSQLRecords])
                                                && !(@Model.currentState[countMYSQLRecords].ToUpper().StartsWith("READY")) &&
                                                !(@Model.currentState[countMYSQLRecords].ToUpper().StartsWith("COMPLETED"))
                                                && !@Model.customActionHideAfterStart[countCustomActions])
                                                {
                                                    <button class="btn" type="submit" name="customAction"
                                                        asp-route-id="@Model.customActionName[countCustomActions]"
                                                        asp-page-handler="MyAction9"><i class="@Model.customActionIcon[countCustomActions]"
                                                            title="@Model.customActionDescription[countCustomActions]"
                                                            style="font-size:24px"></i></button>
                                                }
                                                else if
                                                (@Model.customActionName[countCustomActions].StartsWith(@Model.originatorUUIDs[countMYSQLRecords])
                                                && (@Model.currentState[countMYSQLRecords].ToUpper().StartsWith("COMPLETED"))
                                                && !@Model.customActionHideAfterComplete[countCustomActions])
                                                {
                                                    <button class="btn" type="submit" name="customAction"
                                                        asp-route-id="@Model.customActionName[countCustomActions]"
                                                        asp-page-handler="MyAction9"><i class="@Model.customActionIcon[countCustomActions]"
                                                            title="@Model.customActionDescription[countCustomActions]"
                                                            style="font-size:24px"></i></button>
                                                }
                                                else
                                                {
                                                    <button hidden type="submit" name="customAction"
                                                        asp-route-id="@Model.originatorUUIDs[countMYSQLRecords]"
                                                        asp-page-handler="MyAction9">No Action</button>
                                                }
                                            }
                                        </td>
                                        @if (Model.currentState[countMYSQLRecords].ToUpper().StartsWith("READY"))
                                        {
                                            <td>
                                                <button class="btn" type="button" id="show2_@Model.originatorUUIDs[countMYSQLRecords]"
                                                    onclick="handleCal(this)"><i class="fa fa-calendar" title="Schedule"
                                                        style="font-size:24px"></i></button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                <i hidden class="fa fa-calendar" style="font-size:24px"></i>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <button hidden type="submit" name="ScheduleRun" id="ScheduleRun" asp-route-id=""
                        asp-page-handler="MyAction8"></button>
                </div>
            </form>

            <footer>
                <div>CAST Execution UI</div>
                @if (Model.IsLoginRequired)
                {
                    <form method="post" asp-page-handler="Logout" style="margin: 0;">
                        <button type="submit"
                            style="background: none; border: none; color: rgba(255,255,255,0.55); cursor: pointer; text-decoration: underline; padding: 0; font-size: inherit; font-family: inherit;">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <div style="color:rgba(255,255,255,0.55)">Powered by CAST Framework</div>
                }
            </footer>
        </div>
    }

    <script type="text/javascript" src="/suite_gpl/codebase/suite.js?v=9.2.3"></script>
    <script type="text/javascript" src="/js/cache-clear.js"></script>
    <script>
        function w3_open() {
            document.getElementById("mySidebar").style.display = "block";
        }

        function w3_close() {
            document.getElementById("mySidebar").style.display = "none";
        }

        function refreshDivContent() {
            $("#frameworkStateTable").load(window.location.href + " #frameworkStateTable > *");
            $("#serviceStateTable").load(window.location.href + " #serviceStateTable > *");
        }

        function ManageAutorefresh(checkbox) {
            if (checkbox.checked) {
                autorefreshTimer = setInterval(refreshDivContent, 5000);
            } else {
                clearInterval(autorefreshTimer);
            }
        }

        let autorefreshTimer = setInterval(refreshDivContent, 5000);
        var refreshCheck = document.getElementById("autorefresh");

        const popup = new dhx.Popup({
            css: "dhx_widget--bordered"
        });

        const calendar = new dhx.Calendar(null, {
            dateFormat: "%Y-%m-%d %H:%i:%s",
            timePicker: true,
            css: "dhx_widget--bordered"
        });

        calendar.clear();
        calendar.setValue(new Date());
        popup.attach(calendar);

        var scheduleButton = document.getElementById("ScheduleRun");
        var currentUUID = "";

        function handleCal(button) {
            clearInterval(autorefreshTimer);
            refreshCheck.checked = false;
            popup.show(button.id);
            currentUUID = button.id;
            currentUUID = currentUUID.substring(6);
        }

        calendar.events.on("change", function (mode) {
            var scheduleVar = "aaa";
            if (calendar.getCurrentMode() == "timepicker") {
                scheduleVar = currentUUID + ' scheduled for ' + calendar.getValue();
            }
            if (scheduleVar !== 'aaa') {
                popup.hide();
                let url = `/cast/?param2=schedule_${encodeURIComponent(scheduleVar)}`;
                window.location.href = url;
            }
            return true;
        });

        function changeSelectedGroup() {
            var selectGroupFilterElement = document.getElementById("selectedGroupOption");
            var selectGroupFilterValue = selectGroupFilterElement.value;
            let url = `/cast/?param2=group_${encodeURIComponent(selectGroupFilterValue)}`;
            window.location.href = url;
        }

        function changeSelectedOwner() {
            var selectOwnerFilterElement = document.getElementById("selectedOwnerOption");
            var selectOwnerFilterValue = selectOwnerFilterElement.value;
            let url = `/cast/?param2=owner_${encodeURIComponent(selectOwnerFilterValue)}`;
            window.location.href = url;
        }

        function changeSelectedLocation() {
            var selectLocationFilterElement = document.getElementById("selectedLocationOption");
            var selectLocationFilterValue = selectLocationFilterElement.value;
            let url = `/cast/?param2=location_${encodeURIComponent(selectLocationFilterValue)}`;
            window.location.href = url;
        }

        function changeSelectedKeyword() {
            var selectKeywordFilterElement = document.getElementById("selectedKeywordOption");
            var selectKeywordFilterValue = selectKeywordFilterElement.value;
            let url = `/cast/?param2=keyword_${encodeURIComponent(selectKeywordFilterValue)}`;
            window.location.href = url;
        }
    </script>
</body>

</html>